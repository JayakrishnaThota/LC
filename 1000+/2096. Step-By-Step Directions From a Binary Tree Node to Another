//O(n) time and space
class Solution {
    public String getDirections(TreeNode root, int startValue, int destValue) {
        if(root == null)
            return "";

        StringBuilder startPath = new StringBuilder();
        findPath(root, startValue, startPath);

        StringBuilder destPath = new StringBuilder();
        findPath(root, destValue, destPath);    

        StringBuilder res = new StringBuilder();

        int start = 0, dest = 0;

        while(start < startPath.length() && dest < destPath.length())
        {
            if(startPath.charAt(start) != destPath.charAt(dest))
                break;
            
            start++;
            dest++;
        }
        while(start < startPath.length())
        {
            res.append("U");
            start++;
        }

        res.append(destPath.substring(dest, destPath.length()));
        return res.toString();    
    }

    private boolean findPath(TreeNode root, int target, StringBuilder path)
    {
        if(root == null)
            return false; 

        if(root.val == target)
            return true;

        path.append("L");
        boolean left = findPath(root.left, target, path);
        if(left)
            return true;
        path.deleteCharAt(path.length()-1);

        path.append("R");
        boolean right = findPath(root.right, target, path);
        if(right)
            return true;
        path.deleteCharAt(path.length()-1);

        return false; 
    }    
}
